<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained portable build (BE-093).

  Produces a single VoicemeterAlt.exe (~70 MB) that bundles the .NET 8 runtime
  and runs on any Windows 10+ x64 machine with no .NET install required.
  Mirrors what build.ps1 -Mode portable invokes; this profile lets you publish
  the same artifact directly from `dotnet publish -p:PublishProfile=win-x64-portable`
  or from Visual Studio's Publish dialog.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64-portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Must match the project's TargetFramework — net8.0-windows pulls in
         WinForms (NotifyIcon, system tray UI). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
