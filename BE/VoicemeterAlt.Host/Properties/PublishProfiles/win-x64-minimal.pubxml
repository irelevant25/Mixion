<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent minimal build (BE-093).

  Produces a single VoicemeterAlt.exe (~5 MB) that requires the .NET 8
  Desktop Runtime to be installed on the target machine
  (winget install Microsoft.DotNet.Runtime.8). Used when the user is willing
  to manage the runtime separately in exchange for a much smaller download.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64-minimal\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Must match the project's TargetFramework — net8.0-windows pulls in
         WinForms (NotifyIcon, system tray UI). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>

    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
