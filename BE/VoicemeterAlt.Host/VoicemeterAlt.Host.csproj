<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      net8.0-windows + UseWindowsForms gives us NotifyIcon (system tray) and
      Microsoft.Win32.Registry (Run-on-startup key) without extra packages.
      The whole host is Windows-only anyway (WASAPI, MMCSS, process loopback);
      the prior net8.0 TFM was already a fiction maintained via CA1416 suppression.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <AssemblyName>VoicemeterAlt</AssemblyName>
    <RootNamespace>VoicemeterAlt.Host</RootNamespace>
    <!--
      WinExe = no console window flashes when the user double-clicks the .exe.
      Console output is still available: Shell/ConsoleWindow attaches to a
      parent terminal when launched from cmd/PowerShell, or allocates a hidden
      console that the tray "Console" menu item toggles.
    -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <!--
      System.Drawing.Common is Windows-only post-.NET 6 (the package's
      ThrowOnNonWindowsPlatform is fine for us — the whole host is Windows-only).
      Used by Audio/IconExtractor.cs to ExtractAssociatedIcon from process
      executables for the per-app icons in the FE strip header.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Angular bundle is copied here by build.ps1 before publish.
      Everything in wwwroot/ is embedded into the assembly so the .exe
      ships truly self-contained (no companion wwwroot/ folder).

      During development a placeholder index.html is committed so /
      serves something sensible before the FE bundle is staged.
    -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
    <None Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
